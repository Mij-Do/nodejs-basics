doctype html

html(lang="en")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        title products
    body 
        h1= pageTitle
        p= description
        // products render
        ul
            each product in products 
                li 
                    span= product.title 
                    span= product.price