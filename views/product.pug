extends layout/_base
block title
    title= `${product.id} - ${product.title}`
block content 
    div.w-full.mx-auto.bg-slate-200.p-5.rounded-lg
        div(class="flex w-md mx-auto p-5 space-y-5 flex-col justify-between items-center rounded-lg border border-gray-100 bg-white shadow-md")
            a(href="/products/"+product.id, class="w-full")
                img.rounded-lg.h-60.w-100.mx-auto(src= product.imageURL alt='product image')
            .w-full.flex.flex-col.justify-between.items-center
                a(href="/products/"+product.id)
                    h5.text-xl.tracking-tight.text-slate-900= product.title
                .flex.items-center.justify-between
                    p
                        span.text-3xl.font-bold.text-slate-900= `$${product.price}`
                div
                    button(class='flex items-center justify-center rounded-lg bg-slate-900 text-center text-sm font-medium text-white w-sm py-2.5 hover:bg-gray-700 focus:outline-none focus:ring-4 focus:ring-blue-300') Add to cart