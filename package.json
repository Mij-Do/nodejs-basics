{
  "type": "module",
  "devDependencies": {
    "@faker-js/faker": "^10.5.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.0.1",
    "concurrently": "^9.2.4",
    "nodemon": "^3.1.14",
    "postcss": "^8.5.26",
    "postcss-cli": "^11.0.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "start": "node dist/index.js",
    "build": "tsc -p .",
    "build:css": "postcss public/styles/tailwind.css -o public/styles/global.css",
    "watch:css": "postcss public/styles/tailwind.css -o public/styles/global.css --watch",
    "dev": "concurrently \"npm run watch:css\" \"tsx watch server.ts\""
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pug": "^3.0.4",
    "tailwindcss": "^4.3.3"
  }
}
